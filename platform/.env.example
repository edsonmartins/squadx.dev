# SquadX Platform - Unified Environment Configuration
# Copy this file to .env and fill in the required values.
#
# Usage: docker compose -f platform/docker-compose.yml --env-file platform/.env up

# ═══════════════════════════════════════════════════════
# REQUIRED: Shared Service Authentication
# ═══════════════════════════════════════════════════════

# Shared HMAC secret for service-to-service JWT (min 32 chars)
SQUADX_SERVICE_SECRET=change-me-to-a-secure-random-string-min-32-chars

# JWT secret for user authentication
JWT_SECRET=change-me-to-another-secure-random-string-min-32

# ═══════════════════════════════════════════════════════
# REQUIRED: Supabase (shared by squadx.dev + squadx-live)
# ═══════════════════════════════════════════════════════

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ═══════════════════════════════════════════════════════
# OPTIONAL: Database Passwords (defaults for dev)
# ═══════════════════════════════════════════════════════

POSTGRES_PASSWORD=squadx_dev
LIVE_POSTGRES_PASSWORD=squadx_live_dev
BS_POSTGRES_PASSWORD=brainsentry_dev

# SquadX Live authentication and storage
LIVE_SESSION_SECRET=change-me-to-a-random-cookie-secret-min-32-chars
ARCHGUARD_ISSUER_URL=https://identity.example.com/oauth2/openid/squadx-live
ARCHGUARD_CLIENT_ID=squadx-live
ARCHGUARD_CLIENT_SECRET=
MINIO_ACCESS_KEY=squadx_live
MINIO_SECRET_KEY=change-me-to-a-secure-minio-secret
MINIO_BUCKET=squadx-live-media
MINIO_REGION=us-east-1

# ═══════════════════════════════════════════════════════
# OPTIONAL: LiveKit SFU (squadx-live)
# ═══════════════════════════════════════════════════════

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# WebRTC relay (required for clients behind restrictive NAT/firewalls)
TURN_SERVER_URL=turn:turn.live.squadx.dev:3478
TURN_SERVER_USERNAME=squadx-live
TURN_SERVER_CREDENTIAL=change-me-to-the-turn-secret

# ═══════════════════════════════════════════════════════
# OPTIONAL: LLM API Keys
# ═══════════════════════════════════════════════════════

# For squadx.dev agents (Python client)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# For brainsentry.io (Go backend)
OPENROUTER_API_KEY=

# For squadx.dev Spring AI (optional)
SQUADX_AI_ENABLED=false

# ═══════════════════════════════════════════════════════
# OPTIONAL: Monitoring
# ═══════════════════════════════════════════════════════

GRAFANA_ADMIN_PASSWORD=admin
