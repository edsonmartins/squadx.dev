{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "SquadX",
  "version": "0.1.0",
  "identifier": "dev.squadx.desktop",
  "build": {
    "beforeDevCommand": "cd ../frontend && pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../frontend && pnpm build && pnpm export",
    "frontendDist": "../frontend/out"
  },
  "app": {
    "title": "SquadX - AI-Powered Dev Squads",
    "windows": [
      {
        "title": "SquadX - AI-Powered Dev Squads",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.squadx.dev; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
