# SquadX Frontend Environment Variables
# Copy this file to .env.local and fill in the values.

# Backend API URL - the base URL for the SquadX backend service
NEXT_PUBLIC_API_URL=http://localhost:8080

# WebSocket URL - used for real-time communication with the backend
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# Supabase configuration - required for authentication and real-time features
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# TURN server configuration - used for WebRTC peer-to-peer connections (live sessions)
# Set these if you run your own TURN server
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Cloudflare TURN token - alternative to self-hosted TURN server
# Obtain from Cloudflare Calls dashboard
NEXT_PUBLIC_CLOUDFLARE_TURN_TOKEN=
