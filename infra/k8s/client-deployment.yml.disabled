# DISABLED — the client daemon does NOT run as a Kubernetes pod.
#
# It creates hardened Docker sandboxes via the host Docker daemon, which a plain
# pod cannot reach. Deploy it on a dedicated Docker host instead — see
# client/deploy/README.md. This file is kept (with a .disabled suffix so
# `kubectl apply -f infra/k8s/` skips it) only as a reference for anyone who later
# chooses an in-cluster topology (host-socket mount or a Docker-in-Docker sidecar),
# which would require reworking this manifest and accepting the extra privilege.
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: squadx-client
  namespace: squadx
  labels:
    app.kubernetes.io/name: squadx
    app.kubernetes.io/component: client
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: squadx
      app.kubernetes.io/component: client
  template:
    metadata:
      labels:
        app.kubernetes.io/name: squadx
        app.kubernetes.io/component: client
    spec:
      containers:
        - name: client
          image: ghcr.io/edsonmartins/squadx.dev/client:latest
          resources:
            requests:
              memory: "256Mi"
              cpu: "200m"
            limits:
              memory: "512Mi"
              cpu: "500m"
          envFrom:
            - configMapRef:
                name: squadx-config
            - secretRef:
                name: squadx-secrets
      restartPolicy: Always
