# SquadX client daemon environment — copy to /etc/squadx/squadx-client.env and fill in.
# Consumed by the systemd unit (EnvironmentFile) and read via pydantic settings.

# --- Backend connection (required) ---------------------------------------------
# Point these at the backend running in the cluster (through its ingress).
SQUADX_API_URL=https://api.staging.squadx.dev
SQUADX_WS_URL=wss://api.staging.squadx.dev/ws
# Daemon auth token issued by the backend for this client.
SQUADX_API_TOKEN=change-me

# --- Sandbox backend (ADR-0009) -----------------------------------------------
# Isolator: docker (default, Team DOCKER/VPS) | process | firecracker | remote.
# Only docker is production-ready today (AgentSandbox). process/firecracker/remote
# fail doctor until later phases. Distinct from SQUADX_SANDBOX_RUNTIME (gVisor etc.
# *under* Docker).
SQUADX_SANDBOX_BACKEND=docker
# Dev LIGHT without Docker (needs bwrap on Linux or sandbox-exec on macOS):
# SQUADX_SANDBOX_BACKEND=process
# SQUADX_PROCESS_NETWORK=allow   # or deny (bwrap --unshare-net)
# SQUADX_SANDBOX_RUNTIME=docker

# --- Sandbox images (required) -------------------------------------------------
# The images the daemon runs. Either build them locally on this host
# (`make build-sandbox-images` -> squadx/agent:latest, squadx/egress-proxy:latest,
# which match these defaults) or pull the published ghcr images and set the paths
# below. NOTE: live-view (VNC) needs the :live variant of the agent image.
SQUADX_AGENT_IMAGE=squadx/agent:latest
# For VNC/live-view, use the live-view image instead:
# SQUADX_AGENT_IMAGE=squadx/agent:live
SQUADX_EGRESS_PROXY_IMAGE=squadx/egress-proxy:latest
# If pulling from the registry instead of building locally:
# SQUADX_AGENT_IMAGE=ghcr.io/edsonmartins/squadx.dev/agent:live
# SQUADX_EGRESS_PROXY_IMAGE=ghcr.io/edsonmartins/squadx.dev/egress-proxy:latest

# --- Egress firewall (RFC-0006) ------------------------------------------------
# On by default. Requires the egress-proxy image above and an xt_set-capable host
# kernel. Fails closed if the policy cannot be applied.
SQUADX_EGRESS_SIDECAR=true
SQUADX_NETWORK_POLICY=agent-default

# --- Provider API keys (BYO) — injected per-exec into the sandbox, not the image
# At least one of OpenRouter / OpenAI / Anthropic / Google is required.
# OPENROUTER_API_KEY=sk-or-v1-...
# SQUADX_DEFAULT_MODEL=openrouter/openai/gpt-4o-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# SQUADX_DEFAULT_MODEL=gpt-4o


# --- Concurrency / limits (optional) -------------------------------------------
SQUADX_MAX_CONCURRENT_AGENTS=4
SQUADX_POLL_FALLBACK_INTERVAL_SECONDS=5
SQUADX_AGENT_MEMORY_LIMIT=2g
SQUADX_AGENT_CPU_LIMIT=2.0

# --- Architecture artifacts (optional) ----------------------------------------
# Run SquadX Maps on the daemon host with the same workspace mount.
SQUADX_MAPS_ENABLED=false
SQUADX_MAPS_URL=http://127.0.0.1:8090
SQUADX_MAPS_TIMEOUT_SECONDS=120
# Optional Pullwise callback. The URL template should resolve through the SquadX
# authenticated gateway (or a future short-lived signed artifact endpoint).
PULLWISE_URL=https://pullwise.example.com
PULLWISE_SQUADX_SERVICE_SECRET=change-me-same-value-as-pullwise
SQUADX_ARTIFACT_URL_TEMPLATE=https://app.squadx.dev/artifacts/{artifact_id}
