{
  "expo": {
    "name": "SquadX",
    "slug": "squadx",
    "version": "1.0.0",
    "scheme": "squadx",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "dev.squadx.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.squadx.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": ["expo-router", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
