# SquadX.dev Frontend Environment Variables

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Supabase Configuration (for Live Streaming)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WebRTC TURN Server Configuration (for NAT traversal)
# Option 1: Custom TURN Server
# NEXT_PUBLIC_TURN_URL=turn:your-turn-server.com:3478
# NEXT_PUBLIC_TURN_USERNAME=your-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-credential

# Option 2: Cloudflare TURN (free tier available)
# NEXT_PUBLIC_CLOUDFLARE_TURN_TOKEN=your-cloudflare-turn-token
