# SquadX.dev Python Client Environment Variables

# Backend API Configuration
SQUADX_API_URL=http://localhost:8080
SQUADX_WS_URL=ws://localhost:8080/ws
SQUADX_API_TOKEN=your-api-token-here

# LLM Configuration
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-your-anthropic-key
SQUADX_DEFAULT_MODEL=gpt-4o

# Docker Configuration
SQUADX_DOCKER_NETWORK=squadx-network
SQUADX_AGENT_IMAGE=squadx/agent:latest
SQUADX_MAX_CONCURRENT_AGENTS=4
SQUADX_AGENT_TIMEOUT=3600
SQUADX_AGENT_MEMORY_LIMIT=2g
SQUADX_AGENT_CPU_LIMIT=2.0

# Sandbox Configuration
SQUADX_ENABLE_SANDBOX=true
SQUADX_ENABLE_VNC=true
SQUADX_ENABLE_NETWORK=false

# Local Storage
SQUADX_DATA_DIR=~/.squadx
SQUADX_DB_PATH=~/.squadx/squadx.db
SQUADX_LOG_LEVEL=INFO

# Git Configuration
SQUADX_GIT_USER_NAME=SquadX Agent
SQUADX_GIT_USER_EMAIL=agent@squadx.dev

# Supabase Configuration (for Live Streaming)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# WebRTC TURN Server Configuration (for NAT traversal in production)
# Option 1: Custom TURN Server
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-credential

# Option 2: Cloudflare TURN (free tier available)
# CLOUDFLARE_TURN_TOKEN=your-cloudflare-turn-token
